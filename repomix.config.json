{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "datamermaid - a typed Python SDK for the MERMAID coral reef monitoring API (https://api.datamermaid.org/v1/). This file is a generated, single-file snapshot of the repository for LLM and coding-agent consumption; edit the real sources, never this artifact. Start with README.md for usage and CLAUDE.md for build, test and architecture notes.",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "topFilesLength": 10
  },
  "include": [
    "src/**",
    "tests/**",
    "examples/**",
    "docs/**",
    "mkdocs.yml",
    "*.md",
    "*.toml",
    "LICENSE"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".beads/**",
      ".agents/**",
      ".codex/**",
      ".claude/**",
      "uv.lock",
      "repomix-output.*",
      "dist/**",
      "build/**",
      "**/__pycache__/**",
      "*.egg-info/**",
      ".venv/**",
      "htmlcov/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
